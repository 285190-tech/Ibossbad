{
  "name": "unblocker",
  "description": "Ibossbad — Web proxy & stealth browser powered by Node Unblocker.",
  "author": "Nathan Friedly - http://nfriedly.com",
  "version": "2.4.0",
  "repository": "git://github.com/285190-tech/Ibossbad.git",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/epoxy-transport": "^2.1.29",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@mercuryworkshop/wisp-js": "^0.5.3",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "async": "^3.1.0",
    "content-type": "^1.0.4",
    "cookie": "^0.4.0",
    "debug": "^4.1.1",
    "express": "^4.17.1",
    "iconv-lite": "^0.6.2",
    "jszip": "^3.10.2",
    "libcurl.js": "^0.7.5",
    "lodash": "^4.17.15",
    "mime": "^2.4.4",
    "send": "^0.17.1",
    "set-cookie-parser": "^2.4.1",
    "tld": "0.0.2"
  },
  "devDependencies": {
    "concat-stream": "^2.0.0",
    "eslint": "^7.21.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "hyperquest": "^2.1.3",
    "math-helpers": "~0.1.0",
    "nodemon": "^2.0.2",
    "prettier": "2.2.1",
    "tap": "^15.0.5",
    "ws": "^7.4.4"
  },
  "scripts": {
    "start": "node server.js",
    "watch": "nodemon --watch ./ --ignore ./examples --ext js,html,xhtml,json --exec npm run test",
    "test": "npm run lint && npm run check:catalog && npm run test-spec",
    "pre-commit": "npm run autofix && npm test",
    "lint": "eslint .",
    "autofix": "eslint . --fix",
    "check:catalog": "node scripts/check-game-catalog.js",
    "test-spec": "tap --no-coverage test/*spec.js",
    "test-perf": "node test/performance.js"
  },
  "license": "AGPL-3.0",
  "main": "lib/unblocker.js",
  "files": [
    "lib/",
    "public/",
    "server.js",
    "examples/"
  ]
}
